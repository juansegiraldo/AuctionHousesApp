# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Environment
.venv/
venv/
.env

# Build / tooling
.pytest_cache/
.mypy_cache/
.coverage

# Scraping outputs (legacy + multi-house)
/output/
scraping/output/
scraping/houses/*/output/*.jsonl
scraping/houses/*/output/checkpoints/
# Restos de corridas de prueba apartados de output/ (ver el README de la
# carpeta). Siguen siendo resultados de scrape: no se commitean.
scraping/houses/*/_discarded/*.jsonl

# Data lake / medallion local data
data/bronze/**
data/silver/**
data/gold/**
!data/**/.gitkeep

# Optional enrichment artifacts
data/enrichments/**
!data/enrichments/.gitkeep

# Copias de seguridad locales de resultados de scraping (pesan MB, no se suben)
backups/

# Fuente de Lefebre, curada a mano en 2024 (1,8 MB). Se queda fuera del repo por
# decision explicita. OJO: es la unica fuente de esa casa (1.711 lotes) y de 303
# fichas del maestro de artistas, y no se puede regenerar scrapeando. Quien clone
# el repo no podra ejecutar scraping.houses.lefebre_subastas.from_excel sin
# pedirle el fichero al dueno del repo.
FINALL.xlsx

# Configuracion local de editores
.vscode/
.cursor/

# OS
.DS_Store
Thumbs.db
